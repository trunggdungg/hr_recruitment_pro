<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="job_filter_by_location" inherit_id="website_hr_recruitment.topbar_customizations"
              active="True" priority="46">
        <xpath expr="//div[hasclass('o_jobs_topbar_search_bar')]" position="before">

            <t t-set="location_domain" t-value="[('website_published', '=', True), ('location_id', '!=', False)]"/>
            <t t-if="request.params.get('industry_id')">
                <t t-set="location_domain" t-value="location_domain + [('industry_id', '=', int(request.params.get('industry_id')))]"/>
            </t>
            <t t-if="request.params.get('department_id')">
                <t t-set="location_domain" t-value="location_domain + [('department_id', '=', int(request.params.get('department_id')))]"/>
            </t>
            <t t-if="request.params.get('contract_type_id')">
                <t t-set="location_domain" t-value="location_domain + [('contract_type_id', '=', int(request.params.get('contract_type_id')))]"/>
            </t>
            <t t-if="request.params.get('salary_level_id')">
                <t t-set="location_domain" t-value="location_domain + [('salary_level_id', '=', int(request.params.get('salary_level_id')))]"/>
            </t>

            <t t-set="locations" t-value="request.env['hr.recruitment.location'].sudo().search([('active', '=', True)], order='sequence')"/>
            <t t-set="job_counts" t-value="{g['location_id'][0]: g['location_id_count'] for g in request.env['hr.job'].sudo().read_group(location_domain, ['location_id'], ['location_id'])}"/>
            <t t-set="locations_with_jobs" t-value="locations.filtered(lambda l: job_counts.get(l.id, 0) > 0)"/>

            <t t-if="locations_with_jobs">
                <t t-set="current_location_id" t-value="location_id.id if location_id else None"/>
                <div class="dropdown d-none d-lg-block">
                    <button type="button" class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                        <t t-if="location_id"><t t-out="location_id.city"/></t>
                        <t t-else="">Địa Điểm</t>
                    </button>
                    <div class="dropdown-menu w-100 w-md-auto">
                        <t t-set="params_no_location" t-value="dict((k,v) for k,v in request.params.items() if k not in ('location_id', 'page'))"/>
                        <a t-att-href="'/jobs' + ('?' + '&amp;'.join(k+'='+str(v) for k,v in params_no_location.items()) if params_no_location else '')"
                           t-attf-class="dropdown-item#{' active' if not current_location_id else ''}">
                            Tất cả địa điểm
                            <span class="badge ms-1"><t t-out="sum(job_counts.values())"/></span>
                        </a>
                        <t t-foreach="locations_with_jobs" t-as="loc">
                            <t t-set="params_with_location" t-value="dict((k,v) for k,v in request.params.items() if k not in ('location_id', 'page'))"/>
                            <t t-set="dummy" t-value="params_with_location.update({'location_id': loc.id})"/>
                            <a t-att-href="'/jobs?' + '&amp;'.join(k+'='+str(v) for k,v in params_with_location.items())"
                               t-attf-class="dropdown-item#{' active' if current_location_id == loc.id else ''}">
                                <t t-out="loc.city"/>
                                <t t-if="loc.district">
                                    <span class="text-muted"> - <t t-out="loc.district"/></span>
                                </t>
                                <span class="badge ms-1"><t t-out="job_counts.get(loc.id, 0)"/></span>
                            </a>
                        </t>
                    </div>
                </div>
            </t>

        </xpath>
    </template>
</odoo>
